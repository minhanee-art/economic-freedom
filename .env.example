# ── 데이터베이스 (필수) ───────────────────────────
# Neon Postgres 연결 문자열 (Neon 대시보드 → Connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── 인증 (필수) ───────────────────────────────────
# JWT 세션 서명 키 — 32바이트 이상 무작위 문자열 (openssl rand -hex 32)
JWT_SECRET=replace-with-long-random-string
# Google OAuth (소셜 로그인용, 선택)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── 무차별 대입 방어 레이트리밋 (선택, 미설정 시 인메모리 폴백) ──
# Upstash Redis(무료 티어) → REST URL/TOKEN. 미설정 시 인스턴스 메모리로 동작.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 텔레그램 리포트 / 봇 (Cron) ───────────────────
# @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# 리포트를 받을 채팅 ID (@userinfobot으로 확인)
TELEGRAM_CHAT_ID=123456789
# 웹훅 위조 호출 차단용 시크릿 — 설정 후 GET /api/telegram-bot?setup=1 재실행 필요
TELEGRAM_WEBHOOK_SECRET=
# 리포트 대상 유저 (둘 중 하나만 — ID 우선)
REPORT_USER_EMAIL=you@example.com
# REPORT_USER_ID=uuid-...

# ── 외부 시세/AI (선택) ───────────────────────────
# 한국투자증권 Open API (국내 종목 시세)
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
# OpenAI (감정분석/봇 답변)
OPENAI_API_KEY=sk-...

# ── 운영 (Cron 인증 / 링크) ───────────────────────
# Vercel Cron 인증용 시크릿 (미설정 시 모든 cron 401로 차단됨)
CRON_SECRET=any-long-random-string
# 대시보드 버튼 링크 (기본값 https://economic-freedom.vercel.app)
APP_URL=https://economic-freedom.vercel.app
