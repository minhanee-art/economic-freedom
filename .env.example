# Supabase 설정 (필수)
# Supabase 대시보드 → Settings → Data API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── 월간 텔레그램 리포트 (Cron) ───────────────────────────
# @BotFather에서 발급받은 봇 토큰
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# 리포트를 받을 채팅 ID (개인 채팅이면 본인 user id, @userinfobot으로 확인)
TELEGRAM_CHAT_ID=123456789
# 리포트 대상 유저 (둘 중 하나만 — ID 우선)
REPORT_USER_EMAIL=you@example.com
# REPORT_USER_ID=uuid-...
# Vercel Cron 인증용 시크릿 (Vercel이 Authorization 헤더로 자동 첨부)
CRON_SECRET=any-long-random-string
# 대시보드 버튼 링크 (선택, 기본값 https://economic-freedom.vercel.app)
APP_URL=https://economic-freedom.vercel.app
